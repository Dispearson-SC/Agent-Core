# agent-core - environment configuration for a fresh clone.
#
# Copy this file to `.env` (gitignored, never committed) and fill in the credentials your
# deployment needs. `Settings.from_env` (Core/src/agent_core/composition.py) layers this
# file UNDER the real process environment: a variable exported in the shell always wins
# over the value here, and a missing `.env` is not an error - production sets real
# variables and ships no file at all.
#
# NO SECRET LIVES IN THIS FILE. It is committed. Every credential below ships blank, as a
# comment naming the variable - fill it in only in your own `.env`.

# --------------------------------------------------------------------------------------
# Database (docs/TASKS.md#t-f11-02, #t-f11-24)
# --------------------------------------------------------------------------------------
# Two logical databases, one Postgres instance. The values below point at a LOCAL server -
# the one a fresh clone actually has - never at a remote instance, so a wrong host is never
# the reason `CREATE DATABASE` seems to fail: MissingDatabaseError now names the exact host
# and port it tried, precisely so a checked-in default pointing at the wrong server is
# never the confusing failure again.

# Where the application's own data lives. "agent_core_app" does not exist yet on a fresh
# instance; `start_container` (the one-command production startup path) creates and
# migrates it when AGENT_CORE_ADMIN_DATABASE_URL below is set, idempotently on every start.
AGENT_CORE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_core_app

# An administrative connection string (must be able to CREATE DATABASE) - OPTIONAL, and
# left set here so a fresh clone gets the true one-command start docs/ROADMAP.md's F11
# promises. The application itself never requires superuser to RUN, only to bootstrap: a
# production deployment sets this for one start and removes it afterwards.
AGENT_CORE_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# OPTIONAL. Where AuditSink writes, only if that must be a DIFFERENT database from the one
# above (CLAUDE.md non-negotiable #6 asks for a separate POOL, not a separate database, so
# day 1 leaves this unset and audit rows live beside the domain tables).
# AGENT_CORE_AUDIT_DATABASE_URL=

# --------------------------------------------------------------------------------------
# Model credentials - read directly from the process environment by litellm, NEVER
# through Settings (docs/FIELD-NOTES.md). Left commented so an unfilled line cannot be
# mistaken for a value: an empty `NAME=` here would be a present-but-blank override, and a
# blank credential is a worse failure than a missing one.
# --------------------------------------------------------------------------------------

# MiniMax. litellm reads MINIMAX_API_KEY; this repository's own convention names the same
# credential MINIMAX_API, and composition.py's `Settings.from_env` maps the two at startup
# (docs/TASKS.md#t-f11-23) - a machine with only this file set still makes a model call,
# with nothing exported by hand. Do not rename either side without updating that mapping.
# MINIMAX_API=
# MINIMAX_API_BASE=

# Gemini. litellm reads this name directly - no mapping needed.
# GEMINI_API_KEY=

# --------------------------------------------------------------------------------------
# Day-2 proxy mode (docs/ROADMAP.md, D2) - unset on day 1, library mode.
# --------------------------------------------------------------------------------------
# AGENT_CORE_LITELLM_BASE_URL=
# LITELLM_PROXY_URL=
# LITELLM_KEY_TENANT_A=
# LITELLM_KEY_TENANT_B=

# --------------------------------------------------------------------------------------
# Channels
# --------------------------------------------------------------------------------------
# Telegram bot token - unprefixed, because it names a real external credential the same
# way MINIMAX_API_KEY does for the model gateway.
# TELEGRAM_BOT=
# AGENT_CORE_WHATSAPP_ACCESS_TOKEN=
# AGENT_CORE_WHATSAPP_PHONE_NUMBER_ID=

# Which tenant and profile a channel adapter binds to. Day 1 is a single deployment, so
# both channels share this one pair; "default" is also Settings' own default when unset.
# AGENT_CORE_CHANNEL_TENANT_ID=default
# AGENT_CORE_CHANNEL_PROFILE_ID=

# Which registered channel ChannelHumanGateway asks approvals on. Unset resolves to the
# HTTP channel, which nobody is watching - set this to reach an actual human.
# AGENT_CORE_HUMAN_GATEWAY_CHANNEL_ID=

# --------------------------------------------------------------------------------------
# Directories - default to Core/profiles, Core/skills, Core/media, Core/policy. Override
# only when running from an installed wheel with no Core/ above it.
# --------------------------------------------------------------------------------------
# AGENT_CORE_PROFILES_DIR=
# AGENT_CORE_SKILLS_DIR=
# AGENT_CORE_MEDIA_DIR=
# AGENT_CORE_POLICY_DIR=

# --------------------------------------------------------------------------------------
# DBOS durable engine (docs/TASKS.md#t-f2-12) - the defaults are constants of the source
# and are correct for a single-process deployment. Do not set AGENT_CORE_DBOS_APPLICATION_VERSION
# without reading `dbos_config`'s docstring first: it is a pin, not a preference.
# --------------------------------------------------------------------------------------
# AGENT_CORE_DBOS_APP_NAME=
# AGENT_CORE_DBOS_APPLICATION_VERSION=
# DBOS_CONDUCTOR_KEY=
